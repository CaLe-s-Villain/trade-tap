{
  "name": "trade-tap",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "lint": "npm run lint --workspace client && npm run lint --workspace server",
    "lint:fix": "npm run lint --workspace client -- --fix && npm run lint --workspace server -- --fix",
    "lint:client": "npm run lint --workspace=client",
    "lint:server": "npm run lint --workspace=server",
    "format": "prettier --write .",
    "format:check": "prettier . --check",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "prepare": "node .husky/prepare.js",
    "setup": "npm install && npx husky install",
    "scripts:help": "sh .scripts/help.sh",
    "docker:dev": "docker compose --env-file .env.docker up --build -d",
    "docker:reset": "npm run docker:down && npm run docker:dev",
    "docker:dev:debug": "docker compose --env-file .env.docker up --build",
    "docker:down": "docker compose down -v",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test:unit:client && npm run test:unit:server",
    "test:unit:client": "npm run test:unit --workspace=client",
    "test:unit:server": "npm run test:unit --workspace=server",
    "test:integration": "npm run test:integration:client && npm run test:integration:server",
    "test:integration:client": "npm run test:integration --workspace=client",
    "test:integration:server": "npm run test:integration --workspace=server",
    "test:watch": "npm run test:watch:client && npm run test:watch:server",
    "test:watch:client": "npm run test:watch --workspace=client",
    "test:watch:server": "npm run test:watch --workspace=server",
    "test:e2e": "cypress run"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "concurrently": "^8.2.2",
    "cypress": "^14.2.1",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "husky": "^8.0.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*/*.{js,jsx}": [
      "node scripts/lint-staged-filtered.js"
    ],
    "**/*.{json,md}": [
      "npm run format"
    ]
  }
}
